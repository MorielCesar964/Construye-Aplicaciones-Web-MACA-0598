<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formularios en HTML</title>
<!-- Libreria de iconos en linea -->

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-
awesome/7.3.1/css/all.min.css">

</head>
<body>

<!-- Este es el inicio del formulario, recolecta y envia los datos solicitados -->
<form action="" method="post">
Ingresa tu nombre:
<!-- Campo de texto para ingresar datos-->
<input type="text" name="nombre" size="20">
<br>
<!--Boton que envia el formulario al servidor-->
<input type="submit" value="enviar">
</form> <!--fin del formulario-->
</body>
</html>
